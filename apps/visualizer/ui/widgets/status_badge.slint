import { Theme } from "../theme.slint";

export component StatusBadge inherits Rectangle {
    in property <string> text;
    in property <int> level: 0; // 0=safe, 1=warn, 2=danger, 3=info

    height: 22px;
    border-radius: 11px;
    background: level == 0 ? #0f2e24 : (level == 1 ? #33240d : (level == 2 ? #381420 : #112a3d));
    border-color: Theme.status-color(root.level);
    border-width: 1px;

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        Text {
            text: root.text;
            color: Theme.status-color(root.level);
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}
