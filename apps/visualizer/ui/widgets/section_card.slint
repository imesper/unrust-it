import { Theme } from "../theme.slint";

export component SectionCard inherits Rectangle {
    in property <string> title;
    in-out property <bool> expanded: true;

    background: Theme.bg-surface;
    border-color: Theme.border-subtle;
    border-width: 1px;
    border-radius: Theme.radius-md;

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        Rectangle {
            height: 22px;
            border-radius: 3px;
            background: hdr-touch.has-hover ? Theme.bg-hover : transparent;

            hdr-touch := TouchArea {
                clicked => { root.expanded = !root.expanded; }
            }

            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                Text {
                    text: (root.expanded ? "▾ " : "▸ ") + root.title;
                    color: Theme.text-muted;
                    font-size: 10px;
                    font-weight: 700;
                    letter-spacing: 0.6px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }

        Rectangle {
            visible: root.expanded;
            height: root.expanded ? body-layout.preferred-height : 0px;
            clip: true;

            body-layout := VerticalLayout {
                spacing: 6px;
                @children
            }
        }
    }
}
