import { Theme } from "../theme.slint";

export component TelemetryPlot inherits Rectangle {
    in property <string> title;
    in property <string> readout: "";
    in property <color> accent: Theme.accent-primary;
    in property <image> source;
    in property <float> playhead-fraction: 0.0;
    callback scrub(float);
    callback plot-resized(int, int);

    background: Theme.bg-canvas;
    border-color: Theme.border-subtle;
    border-width: 1px;
    border-radius: Theme.radius-sm;
    clip: true;

    VerticalLayout {
        padding: 4px;
        spacing: 2px;

        HorizontalLayout {
            height: 16px;
            padding-left: 4px;
            padding-right: 4px;
            Text {
                text: root.title;
                color: root.accent;
                font-size: 10px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: root.readout;
                color: Theme.text-primary;
                font-size: 10px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        plot-area := Rectangle {
            vertical-stretch: 1;
            background: Theme.bg-canvas;
            clip: true;

            changed width => {
                root.plot-resized(Math.max(1, Math.round(self.width / 1px)), Math.max(1, Math.round(self.height / 1px)));
            }
            changed height => {
                root.plot-resized(Math.max(1, Math.round(self.width / 1px)), Math.max(1, Math.round(self.height / 1px)));
            }

            Image {
                width: 100%;
                height: 100%;
                source: root.source;
                image-fit: fill;
            }

            // Native Slint 1px playhead cursor (60 FPS zero plot re-rasterization!)
            Rectangle {
                x: Math.clamp(root.playhead-fraction, 0.0, 1.0) * (parent.width - 2px);
                y: 0px;
                width: 2px;
                height: parent.height;
                background: #f8fafc;
                opacity: 0.85;
            }

            touch := TouchArea {
                mouse-cursor: pointer;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && self.width > 1px {
                        root.scrub(Math.clamp(self.mouse-x / self.width, 0.0, 1.0));
                    }
                }
                moved => {
                    if self.pressed && self.width > 1px {
                        root.scrub(Math.clamp(self.mouse-x / self.width, 0.0, 1.0));
                    }
                }
            }
        }
    }
}
