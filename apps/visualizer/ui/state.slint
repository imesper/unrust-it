// Exported application state globals & callbacks bound by Rust AppController.

import {
    CenterViewMode, PlannerMode, CoarseMode, ComputeBackendKind, SolverStatus,
    ToolPresetKind, PrimitiveKind, AcmSliceMode, AcmRuleKind,
    SceneTreeNode, ArmSummary, TouchLinkToggle, ObstacleItem,
    AcmHeaderItem, AcmMatrixRow, SelectedAcmPair, ArmTargetPose, JointSliderItem,
    TimelineAlertMarker
} from "types.slint";

export global SceneState {
    in-out property <[SceneTreeNode]> tree-nodes;
    in-out property <[ArmSummary]> arms;
    in-out property <int> selected-arm-index: 0;
    in-out property <ArmSummary> selected-arm;
    in-out property <[TouchLinkToggle]> selected-arm-touch-links;
    in-out property <bool> has-selected-obstacle: false;
    in-out property <ObstacleItem> selected-obstacle;
    in-out property <string> selected-info-summary: "Select an arm, link, tool, or obstacle";
    in-out property <int> total-dof: 18;
    in-out property <int> total-links: 21;
    in-out property <int> total-tools: 3;

    callback select-tree-node(int);
    callback toggle-tree-expand(int);
    callback add-arm-preset(string);
    callback import-urdf-dialog();
    callback remove-arm(int);
    callback arrange-arms-ring(float);
    callback update-arm-base-pose(int, float, float, float, float);
    callback face-arm-origin(int);
    callback set-arm-tool-preset(int, ToolPresetKind);
    callback update-arm-tool-params(int, float, float);
    callback toggle-tool-touch-link(int, string, bool);
    callback add-obstacle(PrimitiveKind, bool);
    callback add-workpiece-box();
    callback update-obstacle(int, bool, bool, float, float, float, float, float);
    callback remove-obstacle(int);
    callback export-legacy-html();
    callback export-legacy-json();
}

export global AcmState {
    in-out property <AcmSliceMode> slice-mode: AcmSliceMode.inter-arm;
    in-out property <[string]> group-filter-options: ["All", "Arm 0", "Arm 1", "Arm 2", "Tools", "Obstacles"];
    in-out property <int> row-group-index: 1;
    in-out property <int> col-group-index: 2;
    in-out property <string> name-filter: "";
    in-out property <bool> only-active-or-custom: false;

    in-out property <[AcmHeaderItem]> col-headers;
    in-out property <[AcmMatrixRow]> rows;
    in-out property <SelectedAcmPair> selected-pair;

    in-out property <float> bulk-inter-arm-mm: 40.0;
    in-out property <float> bulk-self-mm: 15.0;
    in-out property <float> bulk-tool-tool-mm: 4.0;
    in-out property <float> bulk-tool-wp-mm: 3.0;
    in-out property <float> bulk-tool-link-mm: 15.0;

    callback set-slice-mode(AcmSliceMode);
    callback set-filters(string, bool);
    callback select-cell(string, string);
    callback toggle-cell-quick(string, string);
    callback apply-selected-pair-rule(string, string, AcmRuleKind, float, float);
    callback bulk-set-inter-arm-margin(float);
    callback bulk-set-tool-tool-margin(float);
    callback bulk-set-tool-workpiece-margin(float);
    callback bulk-set-tool-link-margin(float);
    callback reset-acm-from-srdf();
}

export global PlannerState {
    in-out property <[string]> scenario-presets: [
        "3-Arm Close Proximity (18 DOF + 3 Tools)",
        "3-Arm Symmetric Crossing (Deadlock-Free CBF)",
        "Dual-Arm Batched MPPI + 3D ESDF",
        "Dual-Arm RRT-Connect + TOPP-RA",
        "Dual-Arm Closed-Chain + CBF Servo"
    ];
    in-out property <int> active-preset-index: 0;
    in-out property <PlannerMode> mode: PlannerMode.two-stage;
    in-out property <CoarseMode> coarse-mode: CoarseMode.mppi-rrt-fallback;
    in-out property <ComputeBackendKind> compute-backend: ComputeBackendKind.cpu-simd;
    in-out property <string> gpu-adapter-label: "wgpu Metal + SIMD";

    // CBF & Two-Stage tuning
    in-out property <float> safety-margin-mm: 40.0;
    in-out property <float> cbf-activation-mm: 160.0;
    in-out property <float> cbf-gamma: 8.0;
    in-out property <float> tangential-curl-gain: 0.35;
    in-out property <int> mppi-rollouts: 48;
    in-out property <int> mppi-horizon: 16;
    in-out property <int> mppi-iterations: 20;
    in-out property <float> esdf-voxel-mm: 25.0;

    // Targets & Live Joint Jog
    in-out property <[ArmTargetPose]> arm-targets;
    in-out property <int> selected-target-arm: 0;
    in-out property <bool> live-jog-mode: false;
    in-out property <[JointSliderItem]> joints;

    // Non-blocking worker state & diagnostics
    in-out property <SolverStatus> status: SolverStatus.idle;
    in-out property <float> progress: 0.0;
    in-out property <string> status-message: "Ready";
    in-out property <string> diag-solve-ms: "--";
    in-out property <string> diag-pose-err: "--";
    in-out property <string> diag-min-body-clr: "--";
    in-out property <string> diag-min-tool-clr: "--";

    callback load-scenario-preset(int);
    callback set-arm-priority(int, float);
    callback set-cbf-params(float, float, float, float);
    callback set-mppi-params(int, int, int);
    callback set-joint-value(int, float);
    callback update-arm-target(int, float, float, float, float, float, float, float);
    callback copy-current-tcp-to-target(int);
    callback preview-ik-targets();
    callback run-plan();
    callback cancel-plan();
}

export global ViewportState {
    in-out property <image> frame-image;
    in-out property <bool> show-links: true;
    in-out property <bool> show-tool-convex: true;
    in-out property <bool> show-tier1-spheres: false;
    in-out property <bool> show-esdf-slice: false;
    in-out property <int> esdf-slice-axis: 2;
    in-out property <float> esdf-slice-z: 0.42;
    in-out property <float> esdf-opacity: 0.72;
    in-out property <float> esdf-slice-min-z: 0.0;
    in-out property <float> esdf-slice-max-z: 1.0;
    in-out property <bool> show-mppi-ribbons: true;
    in-out property <bool> show-witnesses: true;
    in-out property <bool> witnesses-xray: true;
    in-out property <int> max-witnesses: 5;
    in-out property <bool> show-tf-frames: true;
    in-out property <bool> show-target-ghosts: true;
    in-out property <bool> show-floor-grid: true;

    in-out property <string> hud-title: "3-Arm Close Proximity";
    in-out property <string> hud-safety-label: "READY";
    in-out property <int> hud-safety-level: 3;
    in-out property <string> hud-fps-label: "wgpu 30";

    callback resize-viewport(int, int);
    callback orbit-drag(float, float);
    callback pan-drag(float, float);
    callback zoom-wheel(float);
    callback pick-ray(float, float);
    callback set-camera-preset(string);
    callback layers-changed();
}

export global TimelineState {
    in-out property <bool> playing: false;
    in-out property <bool> looping: true;
    in-out property <int> speed-index: 3;
    in-out property <int> current-frame: 0;
    in-out property <int> total-frames: 1;
    in-out property <float> playhead-fraction: 0.0;
    in-out property <float> stage1-end-fraction: 0.0;
    in-out property <[TimelineAlertMarker]> alert-markers;

    in-out property <string> time-text: "0.00 / 0.00 s";
    in-out property <string> stage-badge: "Stage 1";
    in-out property <string> min-clearance-text: "-- mm";
    in-out property <int> min-clearance-severity: 0;
    in-out property <string> tool-clearance-text: "-- mm";
    in-out property <string> pose-error-text: "-- mm";
    in-out property <string> max-vel-text: "-- rad/s";

    in-out property <image> plot-min-clearance;
    in-out property <image> plot-tool-clearance;
    in-out property <image> plot-pose-error;
    in-out property <image> plot-joint-vel;
    in-out property <int> plot-layout-mode: 0;

    callback toggle-play();
    callback step-frame(int);
    callback seek-fraction(float);
    callback set-speed-index(int);
    callback resize-plots(int, int);
}
