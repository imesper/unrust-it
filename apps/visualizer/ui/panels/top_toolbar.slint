import { Button, ComboBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { CenterViewMode } from "../types.slint";
import { PlannerState, SceneState } from "../state.slint";
import { StatusBadge } from "../widgets/status_badge.slint";

export component TopToolbar inherits Rectangle {
    in-out property <CenterViewMode> center-mode: CenterViewMode.viewport-view;
    in-out property <bool> left-collapsed: false;
    in-out property <bool> right-collapsed: false;

    height: 38px;
    background: Theme.bg-panel;
    border-color: Theme.border-subtle;
    border-width: 1px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 8px;

        Button {
            text: root.left-collapsed ? "▸ Tree" : "◂";
            height: 28px;
            clicked => { root.left-collapsed = !root.left-collapsed; }
        }

        // Studio brand tag
        Rectangle {
            background: #102a3c;
            border-color: Theme.accent-primary;
            border-width: 1px;
            border-radius: 4px;
            height: 28px;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                Text {
                    text: "unrust-it Studio";
                    color: Theme.accent-primary;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }

        ComboBox {
            width: 225px;
            height: 28px;
            model: PlannerState.scenario-presets;
            current-index: PlannerState.active-preset-index;
            selected => {
                PlannerState.active-preset-index = self.current-index;
                PlannerState.load-scenario-preset(self.current-index);
            }
        }

        Rectangle { width: 1px; background: Theme.border-subtle; }

        // Center Workspace Mode Switcher
        HorizontalLayout {
            spacing: 4px;
            Button {
                text: "3D View";
                primary: root.center-mode == CenterViewMode.viewport-view;
                height: 28px;
                clicked => { root.center-mode = CenterViewMode.viewport-view; }
            }
            Button {
                text: "ACM Matrix";
                primary: root.center-mode == CenterViewMode.acm-matrix;
                height: 28px;
                clicked => { root.center-mode = CenterViewMode.acm-matrix; }
            }
            Button {
                text: "Split 3D | ACM";
                primary: root.center-mode == CenterViewMode.split-view;
                height: 28px;
                clicked => { root.center-mode = CenterViewMode.split-view; }
            }
        }

        Rectangle { horizontal-stretch: 1; }

        Button {
            text: "Import URDF";
            height: 28px;
            clicked => { SceneState.import-urdf-dialog(); }
        }
        Button {
            text: "Export JSON";
            height: 28px;
            clicked => { SceneState.export-legacy-json(); }
        }
        Button {
            text: "Export HTML";
            height: 28px;
            clicked => { SceneState.export-legacy-html(); }
        }

        VerticalLayout {
            alignment: center;
            StatusBadge {
                text: PlannerState.gpu-adapter-label;
                level: 3;
            }
        }

        Button {
            text: root.right-collapsed ? "Plan ◂" : "▸";
            height: 28px;
            clicked => { root.right-collapsed = !root.right-collapsed; }
        }
    }
}
