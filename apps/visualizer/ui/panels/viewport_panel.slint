import { Button, Switch } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { SceneState, ViewportState } from "../state.slint";
import { StatusBadge } from "../widgets/status_badge.slint";
import { ParamSlider } from "../widgets/param_slider.slint";

export component ViewportPanel inherits Rectangle {
    in-out property <bool> layers-open: false;

    background: Theme.bg-canvas;
    clip: true;

    changed width => {
        ViewportState.resize-viewport(
            Math.max(1, Math.round(self.width / 1px)),
            Math.max(1, Math.round(self.height / 1px))
        );
    }
    changed height => {
        ViewportState.resize-viewport(
            Math.max(1, Math.round(self.width / 1px)),
            Math.max(1, Math.round(self.height / 1px))
        );
    }

    Image {
        width: 100%;
        height: 100%;
        source: ViewportState.frame-image;
        image-fit: fill;
    }

    // Orbit / Pan / Zoom / Ray-Pick TouchArea
    vp-touch := TouchArea {
        width: 100%;
        height: 100%;
        property <length> last-x: 0px;
        property <length> last-y: 0px;
        property <bool> panning: false;
        mouse-cursor: self.pressed ? grabbing : grab;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                self.last-x = self.mouse-x;
                self.last-y = self.mouse-y;
                self.panning = event.button == PointerEventButton.right
                    || event.button == PointerEventButton.middle
                    || (event.button == PointerEventButton.left && event.modifiers.shift);
            }
        }
        moved => {
            if self.pressed {
                let dx = (self.mouse-x - self.last-x) / 1px;
                let dy = (self.mouse-y - self.last-y) / 1px;
                self.last-x = self.mouse-x;
                self.last-y = self.mouse-y;
                if self.panning {
                    ViewportState.pan-drag(dx, dy);
                } else {
                    ViewportState.orbit-drag(dx, dy);
                }
            }
        }
        scroll-event(event) => {
            ViewportState.zoom-wheel(event.delta-y / 1px);
            return accept;
        }
        double-clicked => {
            if self.width > 1px && self.height > 1px {
                ViewportState.pick-ray(self.mouse-x / self.width, self.mouse-y / self.height);
            }
        }
    }

    // Top-Left HUD Status Pill
    hud-pill := Rectangle {
        x: 10px;
        y: 10px;
        width: Math.min(hud-row.preferred-width, Math.max(160px, parent.width - 20px));
        height: hud-row.preferred-height;
        background: #141922d9;
        border-color: Theme.border-subtle;
        border-width: 1px;
        border-radius: 6px;
        clip: true;

        TouchArea {}

        hud-row := HorizontalLayout {
            padding: 6px;
            spacing: 8px;
            Text {
                text: ViewportState.hud-title;
                color: Theme.text-primary;
                font-size: 11px;
                font-weight: 700;
                vertical-alignment: center;
            }
            StatusBadge {
                text: ViewportState.hud-safety-label;
                level: ViewportState.hud-safety-level;
            }
            Text {
                text: ViewportState.hud-fps-label;
                color: Theme.text-muted;
                font-size: 10px;
                vertical-alignment: center;
            }
        }
    }

    // Top-Right Camera Preset & Layers Bar
    cam-bar-rect := Rectangle {
        x: Math.max(10px, parent.width - self.width - 10px);
        y: (hud-pill.width + self.width + 28px <= parent.width)
            ? 10px
            : (hud-pill.y + hud-pill.height + 6px);
        width: Math.min(cam-row.preferred-width, Math.max(160px, parent.width - 20px));
        height: cam-row.preferred-height;
        background: #141922d9;
        border-color: Theme.border-subtle;
        border-width: 1px;
        border-radius: 6px;
        clip: true;

        TouchArea {}

        cam-row := HorizontalLayout {
            padding: 4px;
            spacing: 4px;
            Button { text: "Iso"; height: 24px; clicked => { ViewportState.set-camera-preset("iso"); } }
            Button { text: "Top"; height: 24px; clicked => { ViewportState.set-camera-preset("top"); } }
            Button { text: "Front"; height: 24px; clicked => { ViewportState.set-camera-preset("front"); } }
            Button { text: "Side"; height: 24px; clicked => { ViewportState.set-camera-preset("side"); } }
            Button { text: "Workpiece"; height: 24px; clicked => { ViewportState.set-camera-preset("workpiece"); } }
            Button {
                text: root.layers-open ? "Layers ▴" : "Layers ▾";
                primary: root.layers-open;
                height: 24px;
                clicked => { root.layers-open = !root.layers-open; }
            }
        }
    }

    // Floating Layers & ESDF Slice Popover
    if root.layers-open: Rectangle {
        x: Math.max(10px, parent.width - self.width - 10px);
        y: cam-bar-rect.y + cam-bar-rect.height + 6px;
        width: 256px;
        height: Math.min(
            layers-body.preferred-height + 2px,
            Math.max(140px, parent.height - self.y - 48px)
        );
        background: #141922f2;
        border-color: Theme.border-focus;
        border-width: 1px;
        border-radius: 6px;
        clip: true;

        TouchArea {}

        Flickable {
            width: 100%;
            height: 100%;
            content-width: self.width;
            content-height: layers-body.preferred-height;

            layers-body := VerticalLayout {
                width: 100%;
                padding: 10px;
                spacing: 6px;
                alignment: start;
                Text {
                    text: "RENDER LAYERS";
                    color: Theme.text-muted;
                    font-size: 10px;
                    font-weight: 700;
                    letter-spacing: 0.6px;
                }
                Switch { text: "Arm Links (Convex)"; checked <=> ViewportState.show-links; toggled => { ViewportState.layers-changed(); } }
                Switch { text: "Attached Tools (Tier-2)"; checked <=> ViewportState.show-tool-convex; toggled => { ViewportState.layers-changed(); } }
                Switch { text: "Tier-1 Spheres (SoA)"; checked <=> ViewportState.show-tier1-spheres; toggled => { ViewportState.layers-changed(); } }
                Switch { text: "3D ESDF Slice Heatmap"; checked <=> ViewportState.show-esdf-slice; toggled => { ViewportState.layers-changed(); } }
                if ViewportState.show-esdf-slice: VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 4px;
                        Text { text: "Axis:"; color: Theme.text-muted; font-size: 11px; vertical-alignment: center; }
                        Button {
                            text: "X";
                            primary: ViewportState.esdf-slice-axis == 0;
                            height: 22px;
                            horizontal-stretch: 1;
                            clicked => { ViewportState.esdf-slice-axis = 0; ViewportState.layers-changed(); }
                        }
                        Button {
                            text: "Y";
                            primary: ViewportState.esdf-slice-axis == 1;
                            height: 22px;
                            horizontal-stretch: 1;
                            clicked => { ViewportState.esdf-slice-axis = 1; ViewportState.layers-changed(); }
                        }
                        Button {
                            text: "Z";
                            primary: ViewportState.esdf-slice-axis == 2;
                            height: 22px;
                            horizontal-stretch: 1;
                            clicked => { ViewportState.esdf-slice-axis = 2; ViewportState.layers-changed(); }
                        }
                    }
                    ParamSlider {
                        label: ViewportState.esdf-slice-axis == 0 ? "ESDF X Offset" : (ViewportState.esdf-slice-axis == 1 ? "ESDF Y Offset" : "ESDF Z Height");
                        unit: "m";
                        minimum: ViewportState.esdf-slice-min-z;
                        maximum: ViewportState.esdf-slice-max-z;
                        step: 0.025;
                        value <=> ViewportState.esdf-slice-z;
                        formatted-value: Math.round(ViewportState.esdf-slice-z * 100.0) / 100.0;
                        edited => { ViewportState.layers-changed(); }
                    }
                    ParamSlider {
                        label: "ESDF Opacity";
                        unit: "";
                        minimum: 0.1;
                        maximum: 0.95;
                        step: 0.05;
                        value <=> ViewportState.esdf-opacity;
                        formatted-value: Math.round(ViewportState.esdf-opacity * 100.0) + "%";
                        edited => { ViewportState.layers-changed(); }
                    }
                }
                Switch { text: "MPPI Rollouts & Trails"; checked <=> ViewportState.show-mppi-ribbons; toggled => { ViewportState.layers-changed(); } }
                Switch { text: "Distance Witnesses"; checked <=> ViewportState.show-witnesses; toggled => { ViewportState.layers-changed(); } }
                if ViewportState.show-witnesses: ParamSlider {
                    label: "Max Witnesses";
                    unit: "";
                    minimum: 1.0;
                    maximum: 16.0;
                    step: 1.0;
                    value: ViewportState.max-witnesses;
                    formatted-value: Math.round(ViewportState.max-witnesses);
                    edited(v) => { ViewportState.max-witnesses = Math.round(v); ViewportState.layers-changed(); }
                }
                Switch { text: "X-Ray Witness Lines"; checked <=> ViewportState.witnesses-xray; toggled => { ViewportState.layers-changed(); } }
                Switch { text: "TCP / TF Frames"; checked <=> ViewportState.show-tf-frames; toggled => { ViewportState.layers-changed(); } }
                Switch { text: "Target & Standoff Ghosts"; checked <=> ViewportState.show-target-ghosts; toggled => { ViewportState.layers-changed(); } }
                Switch { text: "Floor Grid"; checked <=> ViewportState.show-floor-grid; toggled => { ViewportState.layers-changed(); } }
            }
        }
    }

    // Bottom-Left Dynamic N-Arm Legend & Controls Hint
    Rectangle {
        x: 10px;
        y: Math.max(10px, parent.height - self.height - 10px);
        width: Math.min(legend-row.preferred-width, Math.max(160px, parent.width - 20px));
        height: legend-row.preferred-height;
        background: #141922cc;
        border-color: Theme.border-subtle;
        border-width: 1px;
        border-radius: 6px;
        clip: true;

        TouchArea {}

        legend-row := HorizontalLayout {
            padding: 6px;
            spacing: 10px;
            for arm in SceneState.arms: HorizontalLayout {
                spacing: 4px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 9px;
                        height: 9px;
                        border-radius: 5px;
                        background: arm.accent;
                    }
                }
                Text {
                    text: arm.name;
                    color: Theme.text-primary;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }
            Text {
                text: "LMB Orbit · Shift/RMB Pan · Wheel Zoom";
                color: Theme.text-muted;
                font-size: 10px;
                vertical-alignment: center;
            }
        }
    }
}
