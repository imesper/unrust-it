// Engineering studio design tokens & color system for unrust-it Studio.

export global Theme {
    out property <color> bg-canvas: #0d1117;
    out property <color> bg-panel: #141922;
    out property <color> bg-surface: #1b2230;
    out property <color> bg-hover: #232d40;
    out property <color> border-subtle: #263042;
    out property <color> border-focus: #38bdf8;
    out property <color> text-primary: #e6edf3;
    out property <color> text-muted: #8b949e;
    out property <color> accent-primary: #38bdf8;
    out property <color> accent-stage2: #a78bfa;
    out property <color> status-safe: #10b981;
    out property <color> status-warn: #f59e0b;
    out property <color> status-danger: #f43f5e;

    out property <length> control-height: 25px;
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 6px;
    out property <length> pad-sm: 6px;
    out property <length> pad-md: 8px;

    public pure function arm-color(idx: int) -> color {
        if Math.mod(idx, 8) == 0 { return #38bdf8; }
        if Math.mod(idx, 8) == 1 { return #a78bfa; }
        if Math.mod(idx, 8) == 2 { return #34d399; }
        if Math.mod(idx, 8) == 3 { return #fb923c; }
        if Math.mod(idx, 8) == 4 { return #f472b6; }
        if Math.mod(idx, 8) == 5 { return #facc15; }
        if Math.mod(idx, 8) == 6 { return #2dd4bf; }
        return #f87171;
    }

    public pure function status-color(level: int) -> color {
        if level == 0 { return status-safe; }
        if level == 1 { return status-warn; }
        if level == 2 { return status-danger; }
        return accent-primary;
    }
}
