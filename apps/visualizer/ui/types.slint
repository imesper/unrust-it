// Shared data types bridged between Rust controller and Slint 1.19 UI.

export enum CenterViewMode { viewport-view, acm-matrix, split-view }

export enum PlannerMode {
    two-stage,
    three-arm-crossing,
    batch-mppi,
    rrt-toppra,
    closed-chain-cbf,
}

export enum CoarseMode { mppi-rrt-fallback, mppi-only, rrt-only }
export enum ComputeBackendKind { cpu-simd, wgpu-gpu }
export enum SolverStatus { idle, running, converged, warning, failed }

export enum SceneNodeKind {
    group-header,
    arm,
    link,
    frame,
    tool,
    obstacle,
}

export enum ToolPresetKind { none, parallel-gripper, screwdriver, probe, custom }
export enum PrimitiveKind { cuboid, sphere, cylinder, capsule }

export enum AcmSliceMode {
    inter-arm,
    self-collision,
    tools-and-workpieces,
    links-and-obstacles,
    full-filtered,
}

export enum AcmRuleKind {
    enabled,
    custom-margin,
    disabled-adjacent,
    disabled-never,
    disabled-default,
    disabled-dynamic,
    touch-exempt,
    diagonal,
}

export struct SceneTreeNode {
    node-id: int,
    kind: SceneNodeKind,
    entity-id: int,
    robot-id: int,
    depth: int,
    label: string,
    badge: string,
    accent: color,
    expanded: bool,
    has-children: bool,
    visible: bool,
    selected: bool,
}

export struct ArmSummary {
    robot-id: int,
    name: string,
    prefix: string,
    source-label: string,
    dof: int,
    link-count: int,
    accent: color,
    base-x: float,
    base-y: float,
    base-z: float,
    base-yaw-deg: float,
    tool-preset: ToolPresetKind,
    tool-name: string,
    tool-margin-mm: float,
    tool-activation-mm: float,
    tool-mass-kg: float,
    tcp-z-offset-mm: float,
    priority-weight: float,
}

export struct TouchLinkToggle {
    link-id: int,
    name: string,
    exempt: bool,
}

export struct ObstacleItem {
    obstacle-id: int,
    name: string,
    kind: PrimitiveKind,
    is-workpiece: bool,
    carve-esdf: bool,
    pos-x: float,
    pos-y: float,
    pos-z: float,
    margin-mm: float,
    activation-mm: float,
}

export struct AcmHeaderItem {
    entity-key: string,
    short-label: string,
    full-label: string,
    accent: color,
}

export struct AcmCellItem {
    row-key: string,
    col-key: string,
    rule: AcmRuleKind,
    margin-mm: float,
    activation-mm: float,
    label: string,
    live-dist-mm: float,
    near-violation: bool,
    selected: bool,
}

export struct AcmMatrixRow {
    header: AcmHeaderItem,
    cells: [AcmCellItem],
}

export struct SelectedAcmPair {
    valid: bool,
    row-key: string,
    col-key: string,
    pair-title: string,
    pair-kind-badge: string,
    rule: AcmRuleKind,
    locked-adjacent: bool,
    margin-mm: float,
    activation-mm: float,
    live-dist-mm: float,
}

export struct ArmTargetPose {
    robot-id: int,
    arm-name: string,
    tcp-frame-name: string,
    accent: color,
    x: float,
    y: float,
    z: float,
    roll-deg: float,
    pitch-deg: float,
    yaw-deg: float,
    standoff-mm: float,
}

export struct JointSliderItem {
    q-index: int,
    robot-id: int,
    name: string,
    accent: color,
    value: float,
    velocity: float,
    min-val: float,
    max-val: float,
    max-vel: float,
}

export struct TimelineAlertMarker {
    fraction: float,
    is-collision: bool,
}
